# ============================================================
#  The user copies this file to .env and fills in the values
# ============================================================

# ── CoinMarketCap (required) ──
# Get a free API key at: https://coinmarketcap.com/api
CMC_API_KEY=

# ── Telegram (optional, only for notifications) ──
# Create a bot with @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# After sending a message to the bot, visit:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and look for "chat":{"id":XXXXXXX} to find your chat_id
TELEGRAM_CHAT_ID=

# ── Exchange ──
# Options: coinex, kucoin, okx, bybit, kraken, binance, bitget
EXCHANGE_NAME=coinex

# ── Pair to analyze ──
SYMBOL=ETH/USDT

# ── Logging ──
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Scheduler ──
# Automatic background decision checks
# - true  → starts the daemon thread inside the web app
# - false → disabled (only manual checks when opening /data)
SCHEDULER_ENABLED=true

# Interval between checks (in seconds)
# - 300  → 5 min  → 8,640 CMC credits/month (limit)
# - 600  → 10 min → 4,320 CMC credits/month (recommended)
# - 900  → 15 min → 2,880 CMC credits/month
SCHEDULER_INTERVAL_SECONDS=600
