# ============================================================
#  ETH Terminal — Configuration template
#  Copy this file to .env and fill in your values
# ============================================================

# ── CoinMarketCap (required) ──
# Get a free API key at: https://coinmarketcap.com/api
# Basic plan: 10,000 credits/month
CMC_API_KEY=

# ── Telegram (optional, for notifications) ──
# 1. Talk to @BotFather on Telegram
# 2. Send /newbot and follow the instructions
# 3. Paste the token below
# 4. Send any message to your bot
# 5. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 6. Look for "chat":{"id":XXXXXXX} and paste that number below
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Exchange ──
# Options: coinex, kucoin, okx, bybit, kraken, binance, bitget
EXCHANGE_NAME=coinex

# ── Trading pair ──
SYMBOL=ETH/USDT

# ── Scheduler ──
# Background check for pinned decisions
#   true  → start the daemon thread inside the web process
#   false → disabled (manual checks only when loading /data)
SCHEDULER_ENABLED=true

# Interval between checks (in seconds)
#   300 → 5 min  → 8,640 CMC credits/month (at the limit)
#   600 → 10 min → 4,320 CMC credits/month (recommended)
#   900 → 15 min → 2,880 CMC credits/month
SCHEDULER_INTERVAL_SECONDS=600

# ── Logging ──
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
